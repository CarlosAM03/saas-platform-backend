// ============================================================
// GENERATOR & DATASOURCE
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum TenantStatus {
  ACTIVO
  SUSPENDIDO
}

enum UserStatus {
  ACTIVO
  INACTIVO
}

enum RoleName {
  OWNER
  MEMBER
}

enum CampaignStatus {
  ACTIVA
  PAUSADA
  COMPLETADA
  ARCHIVADA
}

enum ProspectStatus {
  ACTIVO
  INACTIVO
}

enum ProspectingJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ============================================================
// MODELS
// ============================================================

model Tenant {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  status      TenantStatus   @default(ACTIVO)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  onboarding TenantOnboarding?

  // Relations
  userTenants UserTenant[]
  roles       Role[]
  campaigns   Campaign[]
  prospects   Prospect[]
  jobs        ProspectingJob[]

  @@map("tenants")
}

model User {
  id          String         @id @default(cuid())
  name        String
  email       String         @unique
  passwordHash String         @map("password_hash")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  ownedOnboardings TenantOnboarding[] @relation("OnboardingOwner")
  createdOnboardings TenantOnboarding[] @relation("OnboardingCreator")
  platformRole String?       @map("platform_role")
  status      UserStatus     @default(ACTIVO)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Relations
  userTenants UserTenant[]
  createdCampaigns Campaign[] @relation("CampaignCreator")
  requestedJobs ProspectingJob[] @relation("JobRequester")

  @@map("users")
}

model UserTenant {
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  roleId    String   @map("role_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  // Relations
  user      User     @relation(fields: [userId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  @@id([userId, tenantId])
  @@map("user_tenants")
}

model Role {
  id          String         @id @default(cuid())
  tenantId    String         @map("tenant_id")
  name        RoleName
  description String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Relations
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  userTenants UserTenant[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Campaign {
  id          String          @id @default(cuid())
  tenantId    String          @map("tenant_id")
  createdBy   String          @map("created_by")
  name        String
  description String?
  status      CampaignStatus  @default(ACTIVA)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  // Relations
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  creator     User            @relation("CampaignCreator", fields: [createdBy], references: [id])
  jobs        ProspectingJob[]
  prospects   Prospect[]      // 1:N directa (origen)
  campaignProspects CampaignProspect[]

  @@map("campaigns")
}

model Prospect {
  id               String          @id @default(cuid())
  tenantId         String          @map("tenant_id")
  campaignId       String          @map("campaign_id")   // campaña de origen
  name             String
  category         String?
  address          String?
  phone            String?
  email            String?
  website          String?
  source           String          // ej. "google_maps"
  sourceIdentifier String?         @map("source_identifier")
  language         String?
  status           ProspectStatus  @default(ACTIVO)
  metadata         Json?           // información adicional flexible
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  // Relations
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  campaign         Campaign        @relation(fields: [campaignId], references: [id])
  campaignProspects CampaignProspect[]

  @@unique([tenantId, campaignId, source, sourceIdentifier])
  @@map("prospects")
}

model CampaignProspect {
  campaignId  String   @map("campaign_id")
  prospectId  String   @map("prospect_id")
  status      String   @default("ACTIVO") // se puede usar enum más adelante
  addedAt     DateTime @default(now()) @map("added_at")

  // Relations
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  prospect    Prospect @relation(fields: [prospectId], references: [id])

  @@id([campaignId, prospectId])
  @@map("campaign_prospects")
}

model ProspectingJob {
  id            String                @id @default(cuid())
  tenantId      String                @map("tenant_id")
  campaignId    String                @map("campaign_id")
  requestedBy   String                @map("requested_by")
  status        ProspectingJobStatus  @default(QUEUED)
  query         Json                  // { keyword, location, source, limit }
  requestedLimit Int?                 @map("requested_limit")
  startedAt     DateTime?             @map("started_at")
  completedAt   DateTime?             @map("completed_at")
  error         String?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  // Relations
  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  campaign      Campaign              @relation(fields: [campaignId], references: [id])
  requester     User                  @relation("JobRequester", fields: [requestedBy], references: [id])

  @@map("prospecting_jobs")
}


enum OnboardingStatus {
  PENDING_FIRST_ACCESS
  COMPLETED
}

enum DeliveryStatus {
  PENDING
  SENDING
  ACCEPTED
  FAILED
  UNKNOWN
}

model TenantOnboarding {
  id String @id @default(cuid())
  tenantId String @unique @map("tenant_id")
  ownerUserId String @unique @map("owner_user_id")
  createdBy String @map("created_by")
  generation Int @default(1)
  activationStatus OnboardingStatus @default(PENDING_FIRST_ACCESS) @map("activation_status")
  deliveryStatus DeliveryStatus @default(PENDING) @map("delivery_status")
  createdAt DateTime @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  owner User @relation("OnboardingOwner", fields: [ownerUserId], references: [id])
  creator User @relation("OnboardingCreator", fields: [createdBy], references: [id])
  links ActivationLink[]
  challenges FirstAccessChallenge[]
  attempts DeliveryAttempt[]
  @@map("tenant_onboardings")
}

model ActivationLink {
  id String @id @default(cuid())
  tokenHash String @unique @map("token_hash")
  onboardingId String @map("onboarding_id")
  generation Int
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  onboarding TenantOnboarding @relation(fields: [onboardingId], references: [id])
  @@unique([onboardingId, generation])
  @@map("activation_links")
}

model FirstAccessChallenge {
  id String @id @default(cuid())
  tokenHash String @unique @map("token_hash")
  onboardingId String @map("onboarding_id")
  generation Int
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  onboarding TenantOnboarding @relation(fields: [onboardingId], references: [id])
  @@unique([onboardingId, generation])
  @@map("first_access_challenges")
}

model DeliveryAttempt {
  id String @id @default(cuid())
  onboardingId String @map("onboarding_id")
  generation Int
  createdAt DateTime @default(now()) @map("created_at")
  leaseExpiresAt DateTime @map("lease_expires_at")
  status DeliveryStatus @default(SENDING)
  providerAcceptedAt DateTime? @map("provider_accepted_at")
  onboarding TenantOnboarding @relation(fields: [onboardingId], references: [id])
  @@index([onboardingId, createdAt])
  @@unique([onboardingId, generation])
  @@index([createdAt])
  @@map("delivery_attempts")
}

model ActivationRateLimit {
  key String @id
  count Int
  expiresAt DateTime @map("expires_at")
  @@index([expiresAt])
  @@map("activation_rate_limits")
}
