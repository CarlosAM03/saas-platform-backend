# Application runtime
NODE_ENV=development
PORT=3000

# Database (local manual execution only; Compose provides its own values)
DATABASE_URL=postgresql://user:password@localhost:5432/saas
DATABASE_ENV=local

# Authentication
JWT_SECRET=replace-with-a-local-secret
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGINS=http://localhost:4200

# Seed/bootstrap (Prisma/seed.ts only)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password

# Development seed (Prisma/seed_dev.ts only)
DEV_SEED_PASSWORD=replace-with-a-unique-demo-password

# Prospector MVP: disabled by default; fill ALL policy values before explicit enablement.
PROSPECTOR_ENABLED=false
PROSPECTOR_BUDGET_APPROVED=false
PROSPECTOR_ALLOW_LOCAL_HTTP=false
PROSPECTOR_SERVICE_URL=
PROSPECTOR_CALLBACK_ORIGIN=
PROSPECTOR_SERVICE_API_KEY=
PROSPECTOR_CALLBACK_API_KEY=
# PROSPECTOR_API_KEY is legacy callback-key fallback ONLY when the new variable is absent.
PROSPECTOR_SERVICE_GENERATION=
PROSPECTOR_HTTP_TIMEOUT_MS=10000
PROSPECTOR_JOB_TIMEOUT_SECONDS=1800
PROSPECTOR_MAX_ACTIVE_JOBS=1
PROSPECTOR_TENANT_JOBS_PER_PERIOD=1
PROSPECTOR_GLOBAL_JOBS_PER_PERIOD=1
PROSPECTOR_QUOTA_PERIOD_SECONDS=86400
PROSPECTOR_MAX_RESULT_BYTES=1048576
PROSPECTOR_MAX_TOTAL_RESULT_BYTES=10485760

# Integration testing (disposable PostgreSQL only)
# INTEGRATION_TEST_DATABASE_URL=postgresql://test:test@localhost:5432/test
