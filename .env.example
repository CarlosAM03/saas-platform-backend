# Application runtime
NODE_ENV=development
PORT=3000

# Database (local manual execution only; Compose provides its own values)
DATABASE_URL=postgresql://user:password@localhost:5432/saas
DATABASE_ENV=local

# Authentication
JWT_SECRET=replace-with-a-local-secret
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGINS=http://localhost:4200

# Seed/bootstrap (Prisma/seed.ts only)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password

# Development seed (Prisma/seed_dev.ts only)
DEV_SEED_PASSWORD=replace-with-a-unique-demo-password

# Prospector future integration (disabled in this release)
# PROSPECTOR_SERVICE_URL=http://localhost:8000
# PROSPECTOR_API_KEY=replace-if-integration-is-enabled
# PLATFORM_CALLBACK_BASE_URL=http://localhost:3000

# Integration testing (disposable PostgreSQL only)
# INTEGRATION_TEST_DATABASE_URL=postgresql://test:test@localhost:5432/test

# ADR-006 / Brevo Free. Copy to .env locally; never commit .env.
# Compose forwards only these variables to api, not db-init.
# Disabled: SMTP credentials may remain empty. Enabled: all are required.
TENANT_REGISTRATION_ENABLED=false
PLATFORM_ACTIVATION_URL=http://localhost:4200/#/activate
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
# SMTP username shown in Brevo (not necessarily the account email).
SMTP_USER=
# Generated SMTP key, NOT the Brevo account password or an API key.
SMTP_PASSWORD=
# Sender verified in Brevo. Fill only in your private .env.
SMTP_FROM=
# Deployed frontend: change PLATFORM_ACTIVATION_URL, for example:
# PLATFORM_ACTIVATION_URL=https://frontend-del-proyecto.com/#/activate
